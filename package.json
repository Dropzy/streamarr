{
  "name": "streamarr",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted live-stream creator platform.",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @streamarr/database db:generate",
    "db:migrate": "pnpm --filter @streamarr/database db:migrate",
    "db:seed": "pnpm --filter @streamarr/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
